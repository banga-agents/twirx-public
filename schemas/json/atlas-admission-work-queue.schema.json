{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twirx.org/schemas/atlas-admission-work-queue-0.1.json",
  "title": "TWIRX Atlas admission work queue 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "selection_digest", "statement", "counts", "origins"],
  "properties": {
    "format": {"const": "tw.atlas-admission-work-queue/0.1"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "selection_digest": {"$ref": "#/$defs/digest"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 16384},
    "counts": {"$ref": "#/$defs/counts"},
    "origins": {"type": "array", "minItems": 500, "maxItems": 500, "items": {"$ref": "#/$defs/origin"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 255},
    "countMap": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 500}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "prepared_dossiers", "unprepared_dossiers", "pending_human_review", "completed_human_review", "canonical_admissions", "policy_review_state", "policy_decision", "next_actions", "domain_families"],
      "properties": {
        "selected": {"const": 500},
        "prepared_dossiers": {"type": "integer", "minimum": 0, "maximum": 500},
        "unprepared_dossiers": {"type": "integer", "minimum": 0, "maximum": 500},
        "pending_human_review": {"type": "integer", "minimum": 0, "maximum": 500},
        "completed_human_review": {"type": "integer", "minimum": 0, "maximum": 500},
        "canonical_admissions": {"type": "integer", "minimum": 0, "maximum": 500},
        "policy_review_state": {"$ref": "#/$defs/countMap"},
        "policy_decision": {"$ref": "#/$defs/countMap"},
        "next_actions": {"$ref": "#/$defs/countMap"},
        "domain_families": {"$ref": "#/$defs/countMap"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_id", "canonical_origin", "domain_family", "dossier_state", "admission_review_state", "canonical_admission", "catalog_state", "policy_review_state", "policy_decision", "next_action", "statement"],
      "properties": {
        "origin_id": {"$ref": "#/$defs/id"},
        "canonical_origin": {"type": "string", "pattern": "^https://[^/?#]+$", "maxLength": 4096},
        "domain_family": {"type": "string", "minLength": 1, "maxLength": 128},
        "dossier_state": {"enum": ["not_prepared", "prepared"]},
        "admission_review_state": {"enum": ["not_started", "pending", "completed"]},
        "canonical_admission": {"type": "boolean"},
        "catalog_state": {"enum": ["candidate", "cataloged"]},
        "policy_review_state": {"enum": ["pending", "completed"]},
        "policy_decision": {"enum": ["permit_live", "permit_with_constraints", "profile_only", "catalog_only", "deny", "uncertain"]},
        "next_action": {"enum": ["prepare_dossier", "human_catalog_review", "human_policy_review", "prepare_bounded_profile_work_order", "advance_technical_evidence", "retain_without_retrieval"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    }
  }
}
