{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twirx.org/schemas/observatory-result-0.1.json",
  "title": "TWIRX local-fixture observatory result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "mode",
    "network_scope",
    "worker_policy_id",
    "job_digest",
    "origin_id",
    "artifact_kind",
    "request_url",
    "final_url",
    "retrieved_at",
    "http_status",
    "media_type",
    "observation_digest",
    "body_digest",
    "body_size",
    "robots_state",
    "product_token",
    "target_path",
    "allowed",
    "matched",
    "matched_pattern",
    "specificity",
    "parse_errors"
  ],
  "properties": {
    "format": {"const": "tw.observatory-result/0.1"},
    "mode": {"const": "local_fixture"},
    "network_scope": {"const": "literal_127.0.0.1_only"},
    "worker_policy_id": {"const": "tw.observatory.local-fixture-v0"},
    "job_digest": {"$ref": "#/$defs/digest"},
    "origin_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
    "artifact_kind": {"const": "robots"},
    "request_url": {"$ref": "#/$defs/fixtureURL"},
    "final_url": {"$ref": "#/$defs/fixtureURL"},
    "retrieved_at": {"type": "string", "format": "date-time", "maxLength": 30},
    "http_status": {"type": "integer", "minimum": 200, "maximum": 299},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
    "observation_digest": {"$ref": "#/$defs/digest"},
    "body_digest": {"$ref": "#/$defs/digest"},
    "body_size": {"type": "integer", "minimum": 0, "maximum": 512000},
    "robots_state": {"const": "successful"},
    "product_token": {"const": "TWIRXBot"},
    "target_path": {"type": "string", "pattern": "^/", "minLength": 1, "maxLength": 16384},
    "allowed": {"type": "boolean"},
    "matched": {"type": "boolean"},
    "matched_pattern": {"type": "string", "maxLength": 16384},
    "specificity": {"type": "integer", "minimum": 0, "maximum": 16384},
    "parse_errors": {"type": "integer", "minimum": 0, "maximum": 512000}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixtureURL": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/robots\\.txt$", "maxLength": 64}
  }
}
