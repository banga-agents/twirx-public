{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twirx.org/schemas/admission-policy-evidence-0.1.json",
  "title": "TWIRX per-origin policy evidence 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "policy", "artifacts"],
  "properties": {
    "format": {"const": "tw.admission-policy-evidence/0.1"},
    "policy": {"$ref": "atlas-policy-set.schema.json#/$defs/policy"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "pattern": "^evidence/[a-zA-Z0-9._/-]+$", "maxLength": 4096},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
