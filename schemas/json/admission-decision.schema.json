{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twirx.org/schemas/admission-decision-0.1.json",
  "title": "TWIRX per-origin admission decision 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "origin_id", "review_state", "admit_to_registry", "reviewer_type", "approval_reference", "catalog_reviewed_at", "catalog_reviewer", "policy_review_state", "policy_decision", "policy_reviewed_at", "policy_reviewer", "rationale", "constraints", "evidence_refs"],
  "properties": {
    "format": {"const": "tw.admission-decision/0.1"},
    "origin_id": {"$ref": "#/$defs/id"},
    "review_state": {"enum": ["pending", "completed"]},
    "admit_to_registry": {"type": "boolean"},
    "reviewer_type": {"enum": ["none", "human"]},
    "approval_reference": {"type": "string", "maxLength": 4096},
    "catalog_reviewed_at": {"$ref": "#/$defs/time"},
    "catalog_reviewer": {"type": "string", "minLength": 1, "maxLength": 4096},
    "policy_review_state": {"enum": ["pending", "completed"]},
    "policy_decision": {"enum": ["permit_live", "permit_with_constraints", "profile_only", "catalog_only", "deny", "uncertain"]},
    "policy_reviewed_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "policy_reviewer": {"type": ["string", "null"], "maxLength": 4096},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 16384},
    "constraints": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
    "time": {"type": "string", "format": "date-time"}
  }
}
