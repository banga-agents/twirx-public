[Unit]
Description=TWIRX sealed public-origin egress work order %i
Documentation=https://twirx.org/security
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/lib/twirx-egress/spool
ConditionPathIsReadWrite=/var/lib/twirx-egress/state

[Service]
Type=oneshot
User=twirx-egress
Group=twirx-egress
ExecStart=/srv/twirx/current/bin/twirx-egress-worker execute --id %i --work-orders /var/lib/twirx-egress/work-orders --control /var/lib/twirx-egress/control.json --spool /var/lib/twirx-egress/spool --state /var/lib/twirx-egress/state
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=/var/lib/twirx-egress/work-orders /var/lib/twirx-egress/control.json
ReadWritePaths=/var/lib/twirx-egress/spool /var/lib/twirx-egress/state
InaccessiblePaths=/srv/twirx/current/.git /srv/twirx/current/atlas /srv/twirx/current/reports /etc/twirx /var/lib/postgresql /run/credentials /run/secrets /root /home
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SocketBindDeny=any
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=127.0.0.0/8
IPAddressDeny=169.254.0.0/16
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.0.0.0/24
IPAddressDeny=192.0.2.0/24
IPAddressDeny=192.168.0.0/16
IPAddressDeny=198.18.0.0/15
IPAddressDeny=198.51.100.0/24
IPAddressDeny=203.0.113.0/24
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
IPAddressDeny=::/128
IPAddressDeny=::1/128
IPAddressDeny=::ffff:0:0/96
IPAddressDeny=64:ff9b:1::/48
IPAddressDeny=100::/64
IPAddressDeny=2001:2::/48
IPAddressDeny=2001:10::/28
IPAddressDeny=2001:db8::/32
IPAddressDeny=3fff::/20
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
IPAddressDeny=ff00::/8
UMask=0077
TimeoutStartSec=45
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
LimitNOFILE=64

[Install]
# Intentionally empty: work orders require explicit operator invocation.
