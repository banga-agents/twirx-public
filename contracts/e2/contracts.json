    {
      "id": "fixture.getOffer",
      "version": "1",
      "origin_id": "controlled-origin-lab",
      "origin_version": "1",
      "title": "Get controlled fixture offer",
      "description": "Returns a typed offer from the controlled local JSON fixture.",
      "resource": "commerce:Offer",
      "effect": "read",
      "evidence_requirement": "observation-v1+transport-v2+field-provenance",
      "native_reference": "origin:testorigin/product",
      "semantic_reference": "commerce:Offer",
      "semantic_closure": ["mapping:testorigin-commerce@0.1.0", "origin:testorigin@2026-08-10", "tw:commerce@0.1.0", "tw:kernel@0.1.0"],
      "input": [{"id":"product_id","description":"Admitted controlled fixture product identifier.","type":"string","required":true,"allowed":["demo-1"],"max_length":16}],
      "output": [
        {"id":"product_id","description":"Origin product identifier.","type":"string","required":true,"native_term":"origin:testorigin/product_id","native_locator":"/product_id","semantic_term":"commerce:Product.identifier","transforms":["trim"],"mapping":"equivalent_in_context"},
        {"id":"product_name","description":"Origin product name.","type":"string","required":true,"native_term":"origin:testorigin/name","native_locator":"/name","semantic_term":"commerce:Product.name","transforms":["trim"],"mapping":"equivalent_in_context"},
        {"id":"price_amount","description":"Origin price lexical value.","type":"decimal","required":true,"native_term":"origin:testorigin/current_price","native_locator":"/offer/current_price","semantic_term":"commerce:OfferPrice.amount","transforms":["trim","decimal_string"],"mapping":"equivalent_in_context"},
        {"id":"price_currency","description":"Origin currency lexical value.","type":"currency_code","required":true,"native_term":"origin:testorigin/currency","native_locator":"/offer/currency","semantic_term":"commerce:OfferPrice.currency","transforms":["trim","uppercase"],"mapping":"equivalent_in_context"},
        {"id":"availability","description":"Optional origin availability.","type":"string","required":false,"native_term":"origin:testorigin/availability","native_locator":"/availability","semantic_term":"commerce:Offer.availability","transforms":["trim","lowercase"],"mapping":"related"}
      ],
      "errors": [{"code":"invalid_input","description":"The product identifier is outside the admitted fixture values."},{"code":"required_evidence_missing","description":"A required source statement is unavailable."}]
    },
    {
      "id": "development.getIndicator",
      "version": "1",
      "origin_id": "world-bank-indicators",
      "origin_version": "v2",
      "title": "Get an admitted development indicator",
      "description": "Returns one World Bank Indicators API value for bounded country, indicator, and year inputs.",
      "resource": "development:IndicatorObservation",
      "effect": "read",
      "evidence_requirement": "observation-v1+transport-v2+field-provenance",
      "native_reference": "origin:worldbank/indicator-response-v2",
      "semantic_reference": "development:IndicatorObservation",
      "semantic_closure": ["development:core@0.1.0", "origin:worldbank@v2", "tw:kernel@0.1.0"],
      "input": [
        {"id":"country","description":"Admitted ISO 3166-1 alpha-3 country code.","type":"string","required":true,"allowed":["CHL","USA","VNM"],"max_length":3},
        {"id":"indicator","description":"Admitted World Bank indicator code.","type":"string","required":true,"allowed":["NY.GDP.MKTP.CD","SP.POP.TOTL"],"max_length":32},
        {"id":"year","description":"Admitted observation year.","type":"integer","required":true,"allowed":["2020","2021","2022","2023","2024","2025"],"max_length":4}
      ],
      "output": [
        {"id":"indicator_id","description":"World Bank indicator identifier.","type":"string","required":true,"native_term":"origin:worldbank/indicator.id","native_locator":"/1/0/indicator/id","semantic_term":"development:Indicator.identifier","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"country_code","description":"World Bank response country code.","type":"string","required":true,"native_term":"origin:worldbank/countryiso3code","native_locator":"/1/0/countryiso3code","semantic_term":"development:IndicatorObservation.countryCode","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"year","description":"World Bank response date field.","type":"integer","required":true,"native_term":"origin:worldbank/date","native_locator":"/1/0/date","semantic_term":"development:IndicatorObservation.year","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"value","description":"World Bank response indicator value.","type":"decimal","required":false,"native_term":"origin:worldbank/value","native_locator":"/1/0/value","semantic_term":"development:IndicatorObservation.value","transforms":["decimal_string"],"mapping":"equivalent_in_context"}
      ],
      "errors": [{"code":"invalid_input","description":"An input is outside the reviewed country, indicator, or year set."},{"code":"origin_unavailable","description":"The admitted official API could not be observed."},{"code":"required_evidence_missing","description":"A required response field is unavailable."}]
    }
  ]
