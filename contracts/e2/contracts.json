        {"id":"gate_id","description":"Publisher gate identifier.","type":"string","required":true,"native_term":"origin:twirx/gate.id","native_locator":"/gate/id","semantic_term":"project:EngineeringGate.id","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"evidence_status","description":"Publisher statement about executed evidence.","type":"string","required":true,"native_term":"origin:twirx/gate.evidence_status","native_locator":"/gate/evidence_status","semantic_term":"project:EngineeringGate.evidenceStatus","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"hosted_ci_status","description":"Recorded hosted CI status.","type":"string","required":true,"native_term":"origin:twirx/remote_ci.status","native_locator":"/remote_ci/status","semantic_term":"project:EngineeringGate.hostedCI","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"report_path","description":"Repository-relative evidence report path.","type":"string","required":true,"native_term":"origin:twirx/gate.report_path","native_locator":"/gate/report_path","semantic_term":"project:EngineeringGate.reportPath","transforms":[],"mapping":"equivalent_in_context"}
      ],
      "errors": [{"code":"origin_unavailable","description":"The admitted publisher origin could not be observed."},{"code":"required_evidence_missing","description":"A required source statement or evidence artifact is unavailable."}]
    },
    {
      "id": "project.listUnresolvedRisks",
      "version": "1",
      "origin_id": "twirx-project",
      "origin_version": "2026-08-10",
      "title": "List published unresolved risks",
      "description": "Returns the complete publisher-authored unresolved-risk list from the observed project status artifact.",
      "resource": "project:RiskRegister",
      "effect": "read",
      "evidence_requirement": "observation-v1+transport-v2+field-provenance",
      "native_reference": "origin:twirx/project-status",
      "semantic_reference": "project:RiskRegister",
      "semantic_closure": ["origin:twirx@2026-08-10", "project:core@0.1.0", "tw:kernel@0.1.0"],
      "input": [],
      "output": [
        {"id":"risks","description":"Publisher-authored unresolved risk statements.","type":"list:string","required":true,"native_term":"origin:twirx/unresolved_risks","native_locator":"/unresolved_risks","semantic_term":"project:RiskRegister.items","transforms":[],"mapping":"source_list"}
      ],
      "errors": [{"code":"origin_unavailable","description":"The admitted publisher origin could not be observed."},{"code":"required_evidence_missing","description":"The risk list is unavailable."}]
