  "operations": [
    {
      "id": "project.getStatus",
      "version": "1",
      "origin_id": "twirx-project",
      "origin_version": "2026-08-10",
      "title": "Get TWIRX project status",
      "description": "Returns the publisher-authored project phase and admitted engineering gate.",
      "resource": "project:Status",
      "effect": "read",
      "evidence_requirement": "observation-v1+transport-v2+field-provenance",
      "native_reference": "origin:twirx/project-status",
      "semantic_reference": "project:Status",
      "semantic_closure": ["origin:twirx@2026-08-10", "project:core@0.1.0", "tw:kernel@0.1.0"],
      "input": [],
      "output": [
        {"id":"phase","description":"Publisher-declared project phase.","type":"string","required":true,"native_term":"origin:twirx/phase","native_locator":"/phase","semantic_term":"project:Status.phase","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"maturity","description":"Publisher-declared maturity.","type":"string","required":true,"native_term":"origin:twirx/maturity","native_locator":"/maturity","semantic_term":"project:Status.maturity","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"engineering_gate","description":"Most recent admitted engineering gate.","type":"string","required":true,"native_term":"origin:twirx/gate.id","native_locator":"/gate/id","semantic_term":"project:Status.engineeringGate","transforms":[],"mapping":"equivalent_in_context"},
        {"id":"gate_status","description":"Publisher-declared implementation status.","type":"string","required":true,"native_term":"origin:twirx/gate.status","native_locator":"/gate/status","semantic_term":"project:Status.gateStatus","transforms":[],"mapping":"equivalent_in_context"}
      ],
      "errors": [{"code":"origin_unavailable","description":"The admitted publisher origin could not be observed."},{"code":"required_evidence_missing","description":"A required source statement or evidence artifact is unavailable."}]
    },
    {
      "id": "project.getEngineeringGateReport",
      "version": "1",
      "origin_id": "twirx-project",
      "origin_version": "2026-08-10",
      "title": "Get engineering gate report status",
      "description": "Returns the current gate evidence statement without converting it into an objective truth claim.",
      "resource": "project:EngineeringGateReport",
      "effect": "read",
      "evidence_requirement": "observation-v1+transport-v2+field-provenance",
      "native_reference": "origin:twirx/project-status",
